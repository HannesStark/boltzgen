# TFG-specific BoltzGen image for GSK3beta pipeline

FROM nvidia/cuda:12.1.0-devel-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/cache/huggingface
ENV TORCH_HOME=/cache/torch

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3-pip \
    git \
    wget \
    curl \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Create symlink for python
RUN ln -s /usr/bin/python3.11 /usr/bin/python

# Install BoltzGen (TFG fork branch)
RUN git clone -b add-bbb-head-and-md https://github.com/manumartinm/boltzgen.git /boltzgen && \
    cd /boltzgen && \
    pip install --no-cache-dir -e .

# Install additional dependencies for TFG
RUN pip install --no-cache-dir \
    pandas \
    tqdm \
    scikit-learn \
    numpy \
    scipy

# Copy GSK3beta design spec placeholder (replace at runtime as needed)
COPY example/double_disulfide_peptide_against_specific_site/norepinephrine.yaml /workspace/design_spec.yaml

ENV PYTHONPATH="/workspace:${PYTHONPATH}"

# Create output directories
RUN mkdir -p /workspace/output /workspace/cache

# Download BoltzGen models (do this during build to save time)
RUN cd /boltzgen && python -c "from src.boltzgen.cli.boltzgen import download_all; download_all()"

# Set working directory
WORKDIR /workspace

# Default command: show usage
CMD ["echo", "BoltzGen TFG Image Ready. Use: boltzgen run /workspace/design_spec.yaml --output /workspace/output"]
